          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Screen sent",
      "description": "Encoder of this side: limited means the browser lowered quality on its own",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({service_name=\"gameplay-web\", deployment_environment_name=\"$env\", kind=\"measurement\"} | logfmt | type=\"webrtc\" | value_screen_out_fps!=\"\" | unwrap value_screen_out_fps | __error__=\"\" [$__auto])",
          "legendFormat": "fps"
        },
        {
          "refId": "B",
          "expr": "avg_over_time({service_name=\"gameplay-web\", deployment_environment_name=\"$env\", kind=\"measurement\"} | logfmt | type=\"webrtc\" | value_screen_out_height!=\"\" | unwrap value_screen_out_height | __error__=\"\" [$__auto])",
          "legendFormat": "height (px)"
        },
        {
          "refId": "C",
          "expr": "avg_over_time({service_name=\"gameplay-web\", deployment_environment_name=\"$env\", kind=\"measurement\"} | logfmt | type=\"webrtc\" | value_screen_out_limited!=\"\" | unwrap value_screen_out_limited | __error__=\"\" [$__auto])",
          "legendFormat": "share limited by bandwidth or CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
