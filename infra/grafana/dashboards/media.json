    },
    {
      "type": "row",
      "title": "Web Vitals",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "LCP p75",
      "description": "Largest Contentful Paint: under 2.5 s is good",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.75, {service_name=\"gameplay-web\", deployment_environment_name=\"$env\", kind=\"measurement\"} | logfmt | type=\"web-vitals\" | value_lcp!=\"\" | unwrap value_lcp | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "LCP"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
