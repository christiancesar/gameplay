      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({service_name=\"gameplay-web\", deployment_environment_name=\"$env\", kind=\"measurement\"} | logfmt | type=\"webrtc\" | value_audio_loss_ratio!=\"\" | unwrap value_audio_loss_ratio | __error__=\"\" [$__auto]) by (context_connection)",
          "legendFormat": "{{context_connection}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
