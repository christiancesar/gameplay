      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time({service_name=\"gameplay-web\", deployment_environment_name=\"$env\", kind=\"measurement\"} | logfmt | type=\"webrtc\" | value_screen_in_fps!=\"\" | unwrap value_screen_in_fps | __error__=\"\" [$__auto])",
          "legendFormat": "fps"
        },
        {
          "refId": "B",
          "expr": "avg_over_time({service_name=\"gameplay-web\", deployment_environment_name=\"$env\", kind=\"measurement\"} | logfmt | type=\"webrtc\" | value_screen_in_height!=\"\" | unwrap value_screen_in_height | __error__=\"\" [$__auto])",
          "legendFormat": "height (px)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
