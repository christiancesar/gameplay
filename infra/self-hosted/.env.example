# Gameplay self-hosting. Copy to .env (npm run host:start does it for you, with random
# secrets) and keep that file private: it is gitignored.

# --- Tunnel -------------------------------------------------------------------
# local: this machine only, at http://localhost:WEB_PORT. No tunnel, nothing
#        reaches the internet. The default.
# quick: no account, random https://*.trycloudflare.com URL on every start.
#        npm run host:start discovers it and writes APP_URL below.
# named: fixed hostname, tunnel created with `cloudflared tunnel create`
#        (credentials file). Needs the named-mode variables below.
# token: fixed hostname, tunnel created in the Cloudflare dashboard (token).
TUNNEL_MODE=local

# URL people open (same name as in infra/production). local and quick modes:
# managed by npm run host:start, leave empty. named/token modes: your hostname, e.g.
# https://gameplay.example.com
APP_URL=

# named mode: tunnel id and the absolute path of its credentials JSON on the host
# (mounted read-only into the container). PUBLIC_HOSTNAME is derived by npm run host:start.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS=
PUBLIC_HOSTNAME=
# User id the named tunnel container runs as (the credentials file is usually
# mode 400). npm run host:start sets it to your own id.
CLOUDFLARED_UID=1000

# token mode only: token of the tunnel (Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# Host port of nginx (bound to 127.0.0.1 only; only the tunnel needs it).
WEB_PORT=8080
# Host port (loopback) where npm run host:start reads the quick tunnel URL.
CLOUDFLARED_METRICS_PORT=20241

# --- Database -----------------------------------------------------------------
# npm run host:start fills the password with a random value. It only applies when the
# database volume is created; changing it later needs ALTER USER in Postgres.
POSTGRES_PASSWORD=
# Host port of the database, loopback only: npm run host:start runs the migrations
# from the repository through it.
POSTGRES_HOST_PORT=5433

# --- Auth secrets (npm run host:start fills them with random values) ---------
# Changing BETTER_AUTH_SECRET signs everyone out. Changing REGISTRATION_KEY_SECRET
# invalidates every unused registration key.
BETTER_AUTH_SECRET=
REGISTRATION_KEY_SECRET=

# --- Platform admin (seeded inside the api container by host:start, idempotent)
# npm run host:start generates a password when this is empty and prints it once.
ADMIN_EMAIL=admin@gameplay.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Voice / WebRTC -----------------------------------------------------------
# cloudflare (default, as in production): Realtime TURN relays the calls that
# cannot connect directly (CGNAT, common on Brazilian ISPs). stun-only: no relay,
# works only when both people have a reachable NAT.
ICE_PROVIDER=cloudflare
# Required when ICE_PROVIDER=cloudflare (Cloudflare dashboard > Realtime > TURN).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Screen share SFU (Cloudflare dashboard > Realtime > Serverless SFU).
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_TOKEN=
# SFU and TURN usage from Cloudflare's analytics API: account id and an API
# token with "Account Analytics: Read" (dashboard > My Profile > API Tokens).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=

# --- API ----------------------------------------------------------------------
LOG_LEVEL=info
# Public API docs at /api/docs. false hides them.
DOCS_ENABLED=true

# --- Observability (optional: everything stays off while empty) ---------------
# deployment.environment.name in Grafana and the Sentry environment, to tell
# this server from dev.
OTEL_DEPLOYMENT_ENVIRONMENT=host

# Sentry: frontend errors. The DSN is baked into the web build: rebuild after
# changing. The org token (Sentry > Settings > Auth Tokens) uploads the source
# maps while building and never lands in the image.
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_ID=
SENTRY_AUTH_TOKEN=

# Grafana Faro (Frontend Observability): Web Vitals, browser traces and call
# quality. Collector URL from the app's Instrument step; empty keeps Faro off.
# The browser sends to /monitoring/faro and nginx forwards here.
FARO_COLLECTOR_URL=

# Grafana Cloud for the api (OpenTelemetry): traces, metrics and logs. Off while
# the endpoint is empty. Grafana Cloud > your stack > OpenTelemetry > Configure:
# endpoint and the "Authorization=Basic ..." header.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=gameplay-api
