# Gameplay self-hosting, host file: tunnel, ports and database, plus what more than one service reads.
# Copy to .env (npm run host:start does it for you, with random secrets) and keep it private: it is gitignored.
# The api variables are in .env.api and the web build ones in .env.web (examples next to this one).

# --- Tunnel -------------------------------------------------------------------
# local: this machine only, at http://localhost:WEB_PORT. No tunnel, nothing
#        reaches the internet. The default.
# quick: no account, random https://*.trycloudflare.com URL on every start.
#        npm run host:start discovers it and writes APP_URL below.
# named: fixed hostname, tunnel created with `cloudflared tunnel create`
#        (credentials file). Needs the named-mode variables below.
# token: fixed hostname, tunnel created in the Cloudflare dashboard (token).
TUNNEL_MODE=local

# URL people open (same name as in infra/production). local and quick modes:
# managed by npm run host:start, leave empty. named/token modes: your hostname, e.g.
# https://gameplay.example.com
APP_URL=

# named mode: tunnel id and the absolute path of its credentials JSON on the host
# (mounted read-only into the container). PUBLIC_HOSTNAME is derived by npm run host:start.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS=
PUBLIC_HOSTNAME=
# User id the named tunnel container runs as (the credentials file is usually
# mode 400). npm run host:start sets it to your own id.
CLOUDFLARED_UID=1000

# token mode only: token of the tunnel (Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# Host port of nginx (bound to 127.0.0.1 only; only the tunnel needs it).
WEB_PORT=8080
# Host port (loopback) where npm run host:start reads the quick tunnel URL.
CLOUDFLARED_METRICS_PORT=20241

# --- Database -----------------------------------------------------------------
# npm run host:start fills the password with a random value. It only applies when the
# database volume is created; changing it later needs ALTER USER in Postgres.
POSTGRES_PASSWORD=
# Host port of the database, loopback only: npm run host:start runs the migrations
# from the repository through it.
POSTGRES_HOST_PORT=5433

# --- Observability --------------------------------------------------------------
# deployment.environment.name in Grafana and the Sentry environment, to tell
# this server from dev.
OTEL_DEPLOYMENT_ENVIRONMENT=host
