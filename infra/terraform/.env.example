# Credentials for running Terraform from this machine. Copy to .env (never committed):
#   cp .env.example .env && chmod 600 .env
# Load before running Terraform:
#   set -a && . ./.env && set +a && terraform plan

# --- AWS: IAM user gameplay (programmatic access only) -----------------------
# Read by the AWS provider and the AWS CLI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Cloudflare ---------------------------------------------------------------
# API token scoped to the oikos.company zone (DNS, Zone Settings, SSL and
# Certificates, Workers Scripts and Routes; Tunnel and Access if SSH goes
# through the tunnel). Read by the Cloudflare provider.
CLOUDFLARE_API_TOKEN=
# Not secrets, Terraform variables.
TF_VAR_cloudflare_account_id=
TF_VAR_cloudflare_zone_id=

# --- SSH ----------------------------------------------------------------------
# Public key installed on the Lightsail instance (the private key stays in ~/.ssh).
TF_VAR_ssh_public_key_path=~/.ssh/gameplay-lightsail.pub
# Only if SSH is opened to this house's IP instead of the Cloudflare Tunnel.
TF_VAR_ssh_allowed_cidr=
