# Gameplay self-hosting. Copy to .env (start.sh does it for you, with random
# secrets) and keep that file private: it is gitignored.

# --- Tunnel -----------------------------------------------------------------
# quick: no account, random https://*.trycloudflare.com URL on every start.
#        start.sh discovers it and writes PUBLIC_URL below.
# named: fixed hostname, tunnel created with `cloudflared tunnel create`
#        (credentials file). Needs the three NAMED variables below.
# token: fixed hostname, tunnel created in the Cloudflare dashboard (token).
TUNNEL_MODE=quick

# Public https URL people use. Quick mode: managed by start.sh, leave empty.
# named/token modes: your hostname, e.g. https://gameplay.example.com
PUBLIC_URL=

# named mode: tunnel id and the absolute path of its credentials JSON on the host
# (mounted read-only into the container). PUBLIC_HOSTNAME is derived by start.sh.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_CREDENTIALS=
PUBLIC_HOSTNAME=
# User id the named tunnel container runs as (the credentials file is usually
# mode 400). start.sh sets it to your own id.
CLOUDFLARED_UID=1000

# token mode only: token of the tunnel (Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# Host port of nginx (bound to 127.0.0.1 only; only the tunnel needs it).
WEB_PORT=8080
# Host port (loopback) where start.sh reads the quick tunnel URL.
CLOUDFLARED_METRICS_PORT=20241

# --- Platform admin (created by the migrate job, idempotent) -----------------
# start.sh generates a password when this is empty and prints it once.
ADMIN_EMAIL=admin@gameplay.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Secrets (start.sh fills them with openssl rand) -------------------------
# Changing BETTER_AUTH_SECRET signs everyone out. Changing REGISTRATION_KEY_SECRET
# invalidates every unused registration key. POSTGRES_PASSWORD only applies when
# the database volume is created; changing it later needs ALTER USER in Postgres.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
REGISTRATION_KEY_SECRET=

# --- Voice / WebRTC -----------------------------------------------------------
# stun-only: works when both people have a reachable NAT. Many Brazilian ISPs use
# CGNAT, where direct WebRTC fails: use cloudflare (free Realtime TURN) then.
ICE_PROVIDER=stun-only
# Required when ICE_PROVIDER=cloudflare (Cloudflare dashboard > Realtime > TURN).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Optional -----------------------------------------------------------------
LOG_LEVEL=info
# Public API docs at /api/docs. false hides them.
DOCS_ENABLED=true
# Frontend error reporting. Baked into the web build: rebuild after changing.
VITE_SENTRY_DSN=
# Telemetry of the api (Grafana Cloud). Off while the endpoint is empty.
# Grafana Cloud > your stack > OpenTelemetry > Configure: endpoint and the
# "Authorization=Basic ..." header. Same values as apps/api/.env work.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=gameplay-api
# deployment.environment.name in Grafana, to tell this server from dev.
OTEL_DEPLOYMENT_ENVIRONMENT=host
