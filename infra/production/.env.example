# Gameplay in production (AWS + Cloudflare, plans/06-producao-aws.md). Copy to
# .env and keep it private: it is gitignored. The deploy scripts read it from
# this machine; the api part goes to the server as its .env (mode 600).
# Values marked "Terraform output" come from `terraform output` in infra/terraform.

# --- Deploy target ------------------------------------------------------------
# Lightsail static IP (Terraform output) and the SSH key made for it.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=ubuntu
DEPLOY_SSH_KEY=~/.ssh/gameplay-lightsail

# --- Public URLs --------------------------------------------------------------
# Web on Cloudflare Workers, API behind the Cloudflare proxy on Lightsail.
WEB_ORIGIN=https://gameplay.oikos.company
BETTER_AUTH_URL=https://unlimited.oikos.company

# --- Database -----------------------------------------------------------------
# Prisma Postgres (us-east-1), direct connection string from the Prisma Console.
# The deploy runs `prisma migrate deploy` from this machine with it.
DATABASE_URL=

# --- Auth secrets -------------------------------------------------------------
# Keep the self-hosted values to bring its data over: Better Auth uses the
# secret for sessions and two-factor data, and the registration keys are signed
# with the other. New values sign everyone out and void unused keys.
BETTER_AUTH_SECRET=
REGISTRATION_KEY_SECRET=

# --- Platform admin (seed, idempotent; only matters on an empty database) -----
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Uploads (Amazon S3) ------------------------------------------------------
STORAGE_DRIVER=s3
S3_REGION=us-east-1
# Terraform outputs: bucket and the access key of the IAM user limited to it.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base of the image URLs: the Cloudflare-cached domain in front of the bucket.
PUBLIC_UPLOADS_URL=

# --- API ----------------------------------------------------------------------
NODE_ENV=production
PORT=3333
LOG_LEVEL=info
DOCS_ENABLED=true
# Cloudflare -> nginx -> api: nginx rewrites X-Forwarded-For with CF-Connecting-IP,
# so the api trusts exactly one hop.
TRUST_PROXY_HOPS=1

# --- Voice / WebRTC -----------------------------------------------------------
# Cloudflare Realtime TURN for voice. The SFU app comes with the SFU tickets.
ICE_PROVIDER=cloudflare
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Web build (deploy:web, baked into the bundle) ----------------------------
# Not read by the web yet: the cross-origin API (INF-04) adds it.
VITE_API_URL=https://unlimited.oikos.company

# --- Observability ------------------------------------------------------------
# deployment.environment.name in Grafana and the Sentry environment.
OTEL_DEPLOYMENT_ENVIRONMENT=production

# Sentry: frontend errors and source maps. Without nginx in front of the web,
# the browser sends straight to Sentry (no /monitoring/sentry tunnel).
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_ID=
SENTRY_AUTH_TOKEN=

# Grafana Faro: the browser sends straight to the collector URL.
VITE_FARO_URL=

# Grafana Cloud for the api (OpenTelemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=gameplay-api
