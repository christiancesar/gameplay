{
  "name": "gameplay",
  "private": true,
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/self-hosted"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "turbo run storybook --filter=web",
    "build-storybook": "turbo run build-storybook",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "e2e": "turbo run e2e",
    "host:start": "node infra/self-hosted/cli/main.ts start",
    "host:stop": "node infra/self-hosted/cli/main.ts stop",
    "host:logs": "node infra/self-hosted/cli/main.ts logs",
    "deploy": "bash infra/production/deploy.sh"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@nestjs/swagger": "11.4.2"
  }
}
