{
  "name": "gameplay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/self-hosted"
  ],
  "scripts": {
    "repo:build": "turbo run build",
    "repo:dev": "turbo run dev",
    "repo:lint": "turbo run lint",
    "repo:typecheck": "turbo run typecheck",
    "repo:test": "turbo run test",
    "repo:format": "turbo run format",
    "repo:format-check": "turbo run format:check",
    "api:dev": "npm run dev -w api",
    "api:build": "npm run build -w api",
    "api:start": "npm run start -w api",
    "api:lint": "npm run lint -w api",
    "api:typecheck": "npm run typecheck -w api",
    "api:test": "npm run test -w api",
    "api:test-e2e": "npm run test:e2e -w api",
    "api:db-up": "npm run db:up -w api",
    "api:db-down": "npm run db:down -w api",
    "api:db-migrate": "npm run db:migrate -w api",
    "api:db-studio": "npm run db:studio -w api",
    "api:seed-admin": "npm run seed:admin -w api",
    "web:dev": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:preview": "npm run preview -w web",
    "web:lint": "npm run lint -w web",
    "web:typecheck": "npm run typecheck -w web",
    "web:test": "npm run test -w web",
    "web:e2e": "npm run e2e -w web",
    "web:e2e-open": "npm run e2e:open -w web",
    "client:storybook": "npm run storybook -w @gameplay/client",
    "client:build-storybook": "npm run build-storybook -w @gameplay/client",
    "client:test": "npm run test -w @gameplay/client",
    "client:lint": "npm run lint -w @gameplay/client",
    "client:typecheck": "npm run typecheck -w @gameplay/client",
    "client:format-check": "npm run format:check -w @gameplay/client",
    "client:icons": "npm run icons -w @gameplay/client",
    "contracts:build": "npm run build -w @gameplay/contracts",
    "contracts:dev": "npm run dev -w @gameplay/contracts",
    "contracts:typecheck": "npm run typecheck -w @gameplay/contracts",
    "contracts:lint": "npm run lint -w @gameplay/contracts",
    "contracts:test": "npm run test -w @gameplay/contracts",
    "env:build": "npm run build -w @gameplay/env",
    "env:dev": "npm run dev -w @gameplay/env",
    "env:typecheck": "npm run typecheck -w @gameplay/env",
    "env:lint": "npm run lint -w @gameplay/env",
    "desktop-bridge:typecheck": "npm run typecheck -w @gameplay/desktop-bridge",
    "desktop-bridge:lint": "npm run lint -w @gameplay/desktop-bridge",
    "desktop-bridge:test": "npm run test -w @gameplay/desktop-bridge",
    "desktop:dev": "npm run start -w desktop",
    "desktop:package": "npm run package -w desktop",
    "desktop:make": "npm run make -w desktop",
    "desktop:publish": "npm run publish -w desktop",
    "desktop:typecheck": "npm run typecheck -w desktop",
    "desktop:lint": "npm run lint -w desktop",
    "desktop:test": "npm run test -w desktop",
    "self-hosted:start": "turbo run build --filter=@gameplay/env --output-logs=errors-only && node infra/self-hosted/cli/main.ts start",
    "self-hosted:stop": "node infra/self-hosted/cli/main.ts stop",
    "self-hosted:logs": "node infra/self-hosted/cli/main.ts logs",
    "self-hosted:typecheck": "npm run typecheck -w @gameplay/self-hosted",
    "self-hosted:lint": "npm run lint -w @gameplay/self-hosted",
    "self-hosted:test": "npm run test -w @gameplay/self-hosted",
    "self-hosted:format-check": "npm run format:check -w @gameplay/self-hosted",
    "deploy:production": "bash infra/production/deploy.sh",
    "windows-dev:up": "bash infra/windows-dev/ssh-key.sh && docker compose -f infra/windows-dev/docker-compose.yml up -d",
    "windows-dev:down": "docker compose -f infra/windows-dev/docker-compose.yml down",
    "windows-dev:ssh": "bash infra/windows-dev/ssh.sh",
    "windows-dev:rdp": "xfreerdp3 /v:localhost:3389 /u:dev /p:dev /dynamic-resolution /sound /microphone +clipboard"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "overrides": {
    "@nestjs/swagger": "11.4.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.18.0"
}
