{
  "name": "gameplay",
  "private": true,
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/self-hosted"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "turbo run storybook --filter=@gameplay/client",
    "build-storybook": "turbo run build-storybook",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "e2e": "turbo run e2e",
    "host:start": "turbo run build --filter=@gameplay/env --output-logs=errors-only && node infra/self-hosted/cli/main.ts start",
    "host:stop": "node infra/self-hosted/cli/main.ts stop",
    "host:logs": "node infra/self-hosted/cli/main.ts logs",
    "deploy": "bash infra/production/deploy.sh",
    "desktop": "npm run start -w desktop",
    "desktop:make": "npm run make -w desktop",
    "desktop:publish": "npm run publish -w desktop",
    "windows:up": "docker compose -f infra/windows-dev/docker-compose.yml up -d",
    "windows:down": "docker compose -f infra/windows-dev/docker-compose.yml down",
    "windows:rdp": "xfreerdp3 /v:localhost:3389 /u:dev /p:dev /dynamic-resolution /sound /microphone +clipboard"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@nestjs/swagger": "11.4.2"
  }
}
