NODE_ENV=development
PORT=3333
LOG_LEVEL=info
DATABASE_URL=postgresql://gameplay:gameplay@localhost:5432/gameplay
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# openssl rand -base64 32
REGISTRATION_KEY_SECRET=change-me-change-me-change-me-change-me
BETTER_AUTH_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:5173
# Uploads: local (default) or s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
PUBLIC_UPLOADS_URL=/uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Proxies in front of the API (1 behind nginx or cloudflared)
TRUST_PROXY_HOPS=0
# ICE: stun-only (default), cloudflare or coturn
ICE_PROVIDER=stun-only
# STUN_URLS=stun:stun.cloudflare.com:3478
# ICE_TTL_SECONDS=86400
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# COTURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# COTURN_SECRET=
# Voice seat kept for reconnection (ms)
# ROOM_RECONNECT_GRACE_MS=30000
# OpenTelemetry over OTLP (Grafana Cloud). Without the endpoint, telemetry stays off.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instanceId:token>
# OTEL_SERVICE_NAME=gameplay-api
# deployment.environment.name in Grafana (defaults to NODE_ENV).
# OTEL_DEPLOYMENT_ENVIRONMENT=development
