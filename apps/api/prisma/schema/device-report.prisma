// Hardware of each device the user signs in from, one row per device. The web
// sends `collected` on sign-in and on "collect again"; `manual` holds what the
// user typed in and survives new collections.
model DeviceReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // uuid generated by the web and kept in the browser.
  deviceId    String
  collected   Json
  manual      Json?
  collectedAt DateTime
  createdAt   DateTime @default(now())

  @@unique([userId, deviceId])
  @@map("device_report")
}
