# Gameplay desktop app. Copy to .env (fora do git) before `npm run desktop` or `npm run desktop:make`.
# Vite bakes the VITE_* values into the app at build time: rebuild after changing.
# The web has its own, in infra/self-hosted/.env.web.

# The server the app talks to. Set: the app is tied to it and never asks for another (what the installers have, and
# `npm run desktop:make` refuses to build without it). Empty: only for `npm run desktop`, where the window asks for one.
# An origin: https://play.example.com (http only for localhost). The Linux release gets it from GAMEPLAY_SERVER_URL.
VITE_SERVER_URL=

# Sentry project of the Electron app (errors of the main process and of the window). The DSN is public by design.
# Empty keeps Sentry off. Sentry > Settings > Projects > (the Electron project) > Client Keys.
VITE_SENTRY_DSN=
# Where this build runs, in Sentry: development or production. Which app sent it (web or desktop) is the `app` tag
# and the project, not part of this name.
VITE_SENTRY_ENVIRONMENT=development

# Source maps of the app, uploaded to the same Sentry project while building (they never ship in the app).
# Needs an org token (Sentry > Settings > Auth Tokens). Empty keeps the upload off.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_ID=
SENTRY_AUTH_TOKEN=
