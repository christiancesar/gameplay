# Gameplay desktop app. Copy to .env (fora do git) before `npm run desktop` or `npm run desktop:make`.
# Vite bakes the VITE_* values into the app at build time: rebuild after changing.
# The web has its own, in infra/self-hosted/.env.web.

# What this build is: development or production. The app and the packaging stop when it is missing or is anything else.
#   production: VITE_SERVER_URL is required. The app is tied to that server and never asks for another.
#   development: VITE_SERVER_URL may stay empty, and the first screen asks which server to use (npm run desktop).
VITE_APP_ENV=development
# The server the app talks to, an origin: https://play.example.com (http only for localhost).
# The Linux release sets both: VITE_APP_ENV in the workflow, VITE_SERVER_URL in the GitHub environment electron-production.
VITE_SERVER_URL=

# Sentry project of the Electron app (errors of the main process and of the window). The DSN is public by design.
# Empty keeps Sentry off. Sentry > Settings > Projects > (the Electron project) > Client Keys.
VITE_SENTRY_DSN=
# Optional. The environment name in Sentry; empty uses VITE_APP_ENV. Which app sent it (web or desktop) is the `app`
# tag and the project, not part of this name.
VITE_SENTRY_ENVIRONMENT=

# Source maps of the app, uploaded to the same Sentry project while building (they never ship in the app).
# Needs an org token (Sentry > Settings > Auth Tokens). Empty keeps the upload off.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_ID=
SENTRY_AUTH_TOKEN=
