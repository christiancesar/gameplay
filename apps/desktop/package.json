{
  "name": "desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Gameplay desktop app: the same front-end as the web, with access to what the browser cannot reach",
  "license": "UNLICENSED",
  "author": "Gameplay",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
